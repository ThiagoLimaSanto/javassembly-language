class Throwable {}
class TestException extends Throwable {}

public class ExceptionCrossMethodTest {
    public static func void throwFromMethod() {
        throw new TestException();
    }

    public static func void main(String[] args) {
        try {
            throwFromMethod();
        } catch (TestException error) {
            printLn "caller caught exception";
        }
        return;
    }
}
