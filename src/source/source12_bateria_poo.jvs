public interface Nomeavel {
    func String obterNome();
}

public class Entidade {
    public String nome = "entidade";

    public func String obterNome() {
        return nome;
    }

    public func int obterCodigo() {
        return 7;
    }
}

public class Usuario extends Entidade implements Nomeavel {
    private final int id = 1;
    private double pontuacao = 2.5;

    public func String obterNome() {
        return super.obterNome();
    }

    public func double obterPontuacao() {
        return pontuacao;
    }

    public func int calcular(int base) {
        int resultado = add base, obterCodigo();
        resultado = add resultado, id;
        return resultado;
    }

    public func String chamarPeloThis() {
        return this.obterNome();
    }
}

public class Util {
    public static final double FATOR = 1.5;

    public static func double aplicarFator(double valor) {
        return mul valor, FATOR;
    }
}

class BaseAcesso {
    int quantidade = 1;

    protected func int obterQuantidade() {
        return quantidade;
    }
}

class DerivadaAcesso extends BaseAcesso {
    public func int testarAcessoProtegido() {
        return obterQuantidade();
    }
}

class Repositorio {
    public String nome = "principal";
    protected int versao = 1;
    private String segredo = "interno";

    public func String obterNome() {
        return nome;
    }

    protected func int obterVersao() {
        return versao;
    }
}

class ClienteRepositorio {
    public func String testarAcesso(Repositorio repositorio) {
        int versaoAtual = repositorio.obterVersao();
        repositorio.versao = add versaoAtual, 1;
        return repositorio.obterNome();
    }
}

