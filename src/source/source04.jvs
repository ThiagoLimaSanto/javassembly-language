public class Funcoes {
    public static func void main(String[] args) {
        anunciar();
        int resultado = soma(10, dobro(5));
        print soma(resultado, add 2, 3);
        print media(2.5, 7.5);
        print escolher(True, "Mensagem");
        return;
    }

    private static func void anunciar() {
        print "Testando chamadas";
        return;
    }

    public static func int soma(int a, int b) {
        return add a, b;
    }

    private static func int dobro(int valor) {
        return mul valor, 2;
    }

    public static func double media(double a, double b) {
        return div (add a, b), 2.0;
    }

    public static func String escolher(boolean ativo, String texto) {
        print ativo;
        return texto;
    }
}
