public class Funcoes {
    public func void main() {
        anunciar(10, 20);
        int resultado = soma(10, dobro(5));
        print soma(resultado, add 2, 3);
        print media(2.5, 7.5);
        print escolher(True, "Mensagem");
        return;
    }

    private func void anunciar() {
        print "Testando chamadas";
        return;
    }

    public func int soma(int a, int b) {
        return add a, b;
    }

    private func int dobro(int valor) {
        return mul valor, 2;
    }

    public func double media(double a, double b) {
        return div (add a, b), 2.0;
    }

    public func String escolher(boolean ativo, String texto) {
        print ativo;
        return texto;
    }
}
