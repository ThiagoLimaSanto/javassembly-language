public interface Nadador {
    func void nadar();
}

public interface Voador {
    func void voar();
}

public class Animal {
    public String nome = "Animal";
    public int idade = 5;

    public func void comer() {
        print "Animal comendo";
    }

    public func String obterNome() {
        return nome;
    }
}

public class Cachorro extends Animal implements Nadador {
    private String raca = "Labrador";

    public func void nadar() {
        print "Cachorro nadando";
    }

    public func void latir() {
        print "Au au!";
    }
}

public class Passaro extends Animal implements Voador {
    private double envergadura = 25.5;

    public func void voar() {
        print "Passaro voando";
    }
}

public class Pato extends Animal implements Voador, Nadador {
    public func void voar() {
        print "Pato voando";
    }

    public func void nadar() {
        print "Pato nadando";
    }
}