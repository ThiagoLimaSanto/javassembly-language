public abstract class FormaBase {
    protected int medida = 0;

    public FormaBase(int medida) {
        this.medida = medida;
    }

    public abstract func int calcular();
}

public class Quadrado extends FormaBase {
    public Quadrado(int lado, int medida) {
        super(medida);
        this.medida = lado;
    }

    public func int calcular() {
        return mul medida, medida;
    }
}

public class TesteObjetos {
    public static func void main(String[] args) {
        FormaBase forma = new Quadrado(4, 5);
        int area = forma.calcular();
        return;
    }
}
