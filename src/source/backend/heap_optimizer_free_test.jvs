public class HeapOptimizerBox {
    int value;
}

public class HeapOptimizerFreeTest {
    public static func void main(String[] args) {
        HeapOptimizerBox first = new HeapOptimizerBox();
        HeapOptimizerBox alias = first;

        boolean beforeFree = cmp.eq first, alias;
        free(first);
        boolean afterFree = cmp.eq first, alias;
        print beforeFree;
        print afterFree;
        return;
    }
}
