public class ArrayInt2DTest {
    public static func void main(String[] args) {
        int[][] matrix = new int[2][3];
        print matrix.length;
        print matrix[0].length;
        matrix[0][1] = 11;
        matrix[0][2] = 12;
        matrix[1][0] = 21;

        print matrix[0][1];
        print matrix[0][2];
        print matrix[1][0];

        int[][] initialized = {{1, 2}, {3, 4}};
        print initialized.length;
        print initialized[1].length;
        print initialized[0][1];
        print initialized[1][0];

        free(matrix[0]);
        free(matrix[1]);
        free(matrix);
        free(initialized[0]);
        free(initialized[1]);
        free(initialized);
        return;
    }
}
