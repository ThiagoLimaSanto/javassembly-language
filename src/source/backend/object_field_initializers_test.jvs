public class PessoaInicializada {
    int idade = 18;
    long documento = 3000000002L;
    static int quantidade = 100;
}

public class ObjectFieldInitializersTest {
    public static func void main(String[] args) {
        PessoaInicializada pessoa = new PessoaInicializada();

        print pessoa.idade;
        print pessoa.documento;

        pessoa.idade = 21;
        print pessoa.idade;
        return;
    }
}
