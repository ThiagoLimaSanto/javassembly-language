public class Funcionario extends PessoaBase {
    double salario = 3500.5;
    static int quantidade = 7;
}

public class PessoaBase {
    int idade = 18;
    long documento = 3000000002L;
}

public class ObjectInheritanceTest {
    public static func void main(String[] args) {
        Funcionario funcionario = new Funcionario();
        int valor = 10;

        printf "valor: %d\n", valor;
        print funcionario.idade;
        print funcionario.documento;
        print funcionario.salario;

        free(funcionario);

        funcionario.documento = 4000000003L;
        print funcionario.documento;
        return;
    }
}
