public class ArrayPrimitiveTest {
    public static func void main(String[] args) {
        int[] valores = new int[3];
        valores[0] = 10;
        valores[1] = 20;
        valores[2] = add valores[0], valores[1];

        long[] documentos = {3000000002L, 4000000003L};
        double[] notas = new double[2];
        notas[0] = 7.5;
        notas[1] = 9.25;
        boolean[] aprovado = {True, False};
        String[] mensagens = {"Olá", "arrays"};

        print valores.length;
        print valores[2];
        print documentos[1];
        print notas[0];
        print aprovado[0];
        print aprovado[1];
        print mensagens[0];

        free(valores);
        free(documentos);
        free(notas);
        free(aprovado);
        return;
    }
}
