public class ArrayPerson {
    int age;
}

public class ArrayGroup {
    ArrayPerson[] people = new ArrayPerson[2];
}

public class ArrayReferenceTest {
    public static func void main(String[] args) {
        ArrayGroup group = new ArrayGroup();
        group.people[0] = new ArrayPerson();
        group.people[1] = new ArrayPerson();
        group.people[0].age = 18;
        group.people[1].age = 25;

        print group.people.length;
        print group.people[0].age;
        print group.people[1].age;

        free(group.people[0]);
        free(group.people[1]);
        free(group.people);
        free(group);
        return;
    }
}
