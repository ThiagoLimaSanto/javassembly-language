public class DispatchAnimal {
    int value = 10;

    public func int speak(int extra) {
        return add this.value, extra;
    }

    public func int dispatch(int extra) {
        return this.speak(extra);
    }
}

public class DispatchDog extends DispatchAnimal {
    public func int speak(int extra) {
        return add super.speak(extra), 1;
    }
}

public class VirtualDispatchTest {
    public static func void main(String[] args) {
        DispatchAnimal animal = new DispatchDog();
        print animal.speak(5);
        print animal.dispatch(5);
        return;
    }
}
