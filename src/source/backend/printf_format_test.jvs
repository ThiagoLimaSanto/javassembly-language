public class PrintfFormatTest {
    // Saída esperada:
    // int=42 signed=42 unsigned=42 long=3000000000 long-int=3000000000 float=3.500000 double=3.500000 text=Javassembly bool=1 %
    // 100% concluído
    public static func void main(String[] args) {
        int integer = 42;
        long largeInteger = 3000000000L;
        double decimal = 3.5;
        boolean enabled = True;
        String text = "Javassembly";

        printf "int=%d long=%ld long-int=%li float=%f double=%lf text=%s bool=%b %%\n",
                integer, largeInteger, largeInteger,
                decimal, decimal, text, enabled;
        printf "100%% concluído\n";
    }
}
