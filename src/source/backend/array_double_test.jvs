public class ArrayDoubleTest {
    public static func void main(String[] args) {
        double[] values = new double[3];

        print values.length;
        print values[0];
        values[0] = 7.5;
        values[1] = 9.25;
        values[2] = 3500.5;
        print values[0];
        print values[1];
        print values[2];

        free(values);
        return;
    }
}
