public class BackendComparisons {
    public static func void compare(int left, int right) {
        if (cmp.gt right, left) {
            printLn 1;
        } else {
            printLn 0;
        }
        if (cmp.le right, left) {
            printLn 1;
        } else {
            printLn 0;
        }
        if (cmp.ge right, left) {
            printLn 1;
        } else {
            printLn 0;
        }
        if (cmp.ne right, left) {
            printLn 1;
        } else {
            printLn 0;
        }
        return;
    }

    public static func void main(String[] args) {
        compare(3, 7);
        return;
    }
}
