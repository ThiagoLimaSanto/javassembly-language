public class BackendArithmetic {
    public static func int calculate(int left, int right) {
        int sum = add left, right;
        int difference = sub left, right;
        int product = mul sum, difference;
        int quotient = div product, 2;
        int remainder = mod left, right;
        int negative = neg right;
        printLn sum;
        printLn difference;
        printLn quotient;
        printLn remainder;
        printLn negative;
        return quotient;
    }

    public static func void main(String[] args) {
        int result = calculate(9, 3);
        if (cmp.eq result, 18) {
            printLn 1;
        } else {
            printLn 0;
        }

        int index = 0;
        while (cmp.lt index, 3) {
            index = add index, 1;
        }
        printLn index;
        return;
    }
}
