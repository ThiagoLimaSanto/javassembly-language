public class Valor {
    int numero = 7;
}

public class Caixa {
    Valor valor = new Valor();
}

public class ObjectReferenceFieldTest {
    public static func void main(String[] args) {
        Caixa caixa = new Caixa();

        print caixa.valor.numero;
        caixa.valor.numero = 42;
        print caixa.valor.numero;
        return;
    }
}
