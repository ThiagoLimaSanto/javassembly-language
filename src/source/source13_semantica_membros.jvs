public class BaseMembros {
    public static int compartilhado = 1;
    protected int valor = 2;
    public final int constante = 10;

    public final func int fixo() {
        return constante;
    }

    protected func int calcular(int base) {
        return add base, valor;
    }
}

public class Membros extends BaseMembros {
    public static int compartilhado = 2;
    private static final int LIMITE = 100;

    public func int calcular(int base) {
        return super.calcular(base);
    }

    public func double calcular(double base) {
        return add base, 1.0;
    }

    public func int ler(BaseMembros referencia) {
        return referencia.valor;
    }

    public static func int limite() {
        return LIMITE;
    }

    public static func void main(String[] args) {
        return;
    }
}
