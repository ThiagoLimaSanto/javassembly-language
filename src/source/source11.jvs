class Pessoa {
    private String nome;
    private int idade;

    func void apresentar() {
        print nome;
        print idade;
    }

    func String getNome() {
        return nome;
    }
}

class Funcionario extends Pessoa {

    private double salario;
    private Pessoa responsavel;

    func void cadastrar(Pessoa pessoa, int idade, double salario) {
        Pessoa novoResponsavel;
        this.salario = salario;
        super.apresentar();
    }

    func Pessoa obterResponsavel() {
        return responsavel;
    }

    func void apresentarFuncionario() {
        super.apresentar();
        print salario;
    }
}

interface Autenticavel {
    func boolean autenticar(String senha);
}