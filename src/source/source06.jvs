public class Iteracoes {
    public static func void main() {
        int soma = 0;

        for (int i = 0; cmp.lt i, 5; i = add i, 1) {
            soma = add soma, i;
        }

        while (cmp.lt soma, 20) {
            soma = add soma, 1;
        }

        print soma;
        return;
    }
}
