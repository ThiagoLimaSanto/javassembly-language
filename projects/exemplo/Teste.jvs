package projects.exemplo;

class Throwable {}
class MinhaExcecao extends Throwable {}

public class Exemplo {
    public static func void main(String[] args) {
        try {
            throw new MinhaExcecao();
        } catch (MinhaExcecao e) {
            printLn "capturada";
        } finally {
            printLn "sempre executado";
        }
        return;
    }
}