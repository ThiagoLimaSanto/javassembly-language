#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)) || [[ "$1" == "help" || "$1" == "--help" || "$1" == "-h" ]]; then
    printf 'Uso: jvsc <caminhoArquivo.jvs>\n'
    printf 'Compila o arquivo e grava os artefatos em out/ ao lado do projeto ou arquivo.\n'
    exit 0
fi

if (($# != 1)) || [[ "$1" != *.jvs ]]; then
    printf 'Erro: informe um único arquivo-fonte com extensão .jvs.\n' >&2
    exit 2
fi

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"

# In a checkout, the launcher lives at the compiler root. After installation,
# it lives in ~/.local/bin and the compiler is stored in ~/.local/lib.
if [[ -d "$script_dir/compiler" ]]; then
    repo_root="$script_dir"
elif [[ -n "${JAVASSEMBLY_HOME:-}" && -d "$JAVASSEMBLY_HOME/compiler" ]]; then
    repo_root="$(cd -- "$JAVASSEMBLY_HOME" && pwd)"
elif [[ -d "${HOME}/.local/lib/javassembly/compiler" ]]; then
    repo_root="${HOME}/.local/lib/javassembly"
else
    printf 'Erro: não encontrei a instalação do JavaAssembly. Reinstale com install.sh.\n' >&2
    exit 1
fi
if [[ -w "$repo_root" ]]; then
    compiler_classes="$repo_root/build/compiler"
else
    cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/javassembly"
    compiler_classes="$cache_root/compiler"
fi
mkdir -p "$compiler_classes"

mapfile -t java_sources < <(find "$repo_root/compiler" -type f -name '*.java' -print | sort)
if ((${#java_sources[@]} == 0)); then
    printf 'Erro: não encontrei fontes Java em %s/compiler.\n' "$repo_root" >&2
    exit 1
fi

javac -d "$compiler_classes" "${java_sources[@]}"
exec java -Djavassembly.libraryRoot="$repo_root/lib" \
    -cp "$compiler_classes" compiler.Main build "$1"
