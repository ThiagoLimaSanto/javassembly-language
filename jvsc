#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)) || [[ "$1" == "help" || "$1" == "--help" || "$1" == "-h" ]]; then
    printf 'Uso: jvsc -l|-w <caminhoArquivo.jvs>\n'
    printf '  -l  compila para Linux x86-64\n'
    printf '  -w  compila para Windows x86-64\n'
    exit 0
fi

if (($# != 2)) || [[ "$2" != *.jvs ]]; then
    printf 'Erro: use jvsc -l|-w caminhoArquivo.jvs.\n' >&2
    exit 2
fi

case "$1" in
    -l|-w) target_flag="$1" ;;
    *)
        printf "Erro: destino inválido '%s'. Use -l (Linux) ou -w (Windows).\n" "$1" >&2
        exit 2
        ;;
esac

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"

# Release packages keep the launcher, JAR, and libraries together. Per-user
# installs keep the launcher in ~/.local/bin and the JAR in ~/.local/lib.
if [[ -f "$script_dir/javassembly.jar" ]]; then
    repo_root="$script_dir"
elif [[ -n "${JAVASSEMBLY_HOME:-}" && -f "$JAVASSEMBLY_HOME/javassembly.jar" ]]; then
    repo_root="$(cd -- "$JAVASSEMBLY_HOME" && pwd)"
elif [[ -f "${HOME}/.local/lib/javassembly/javassembly.jar" ]]; then
    repo_root="${HOME}/.local/lib/javassembly"
else
    printf 'Erro: não encontrei javassembly.jar. Instale o pacote de uma Release ou execute install.sh a partir do código-fonte.\n' >&2
    exit 1
fi
if [[ ! -d "$repo_root/lib" ]]; then
    printf 'Erro: a pasta de bibliotecas não foi encontrada em %s/lib. Reinstale o JavaAssembly.\n' "$repo_root" >&2
    exit 1
fi

exec java "-Djavassembly.libraryRoot=$repo_root/lib" \
    -jar "$repo_root/javassembly.jar" build "$target_flag" "$2"
